# scripted/written by Robert Bopko (github.com/zeroznet) with Boba Bott (Claude Sonnet 4.6)
#
# Multi-stage build for the wsl-vpnfix appliance rootfs.
# Stages:
#   1. builder       : compile our Go orchestrator with reproducible flags
#   2. gvproxy-builder : build gvproxy-windowsgui.exe from pinned upstream
#                        source plus build/patches/gvproxy-hires-clock.patch
#   3. fetcher       : download + verify the upstream gvforwarder binary
#   4. final         : Alpine rootfs assembly, exported by build/pack.sh

# ---- Stage 1: Go builder ----
# Same Alpine digest as dev/Containerfile and the final stage so the build
# tree and the runtime tree share one pinned base. Bump via Renovate PR.
FROM alpine@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS builder

ARG VERSION=dev
ARG COMMIT=none
ARG SOURCE_DATE_EPOCH=0

RUN apk add --no-cache \
        go=1.26.11-r0 \
        git \
        ca-certificates

ENV CGO_ENABLED=0 \
    GOPATH=/root/go \
    GOCACHE=/root/.cache/go-build \
    GOTOOLCHAIN=local \
    GOFLAGS="-buildvcs=false -mod=readonly"

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal

# -trimpath strips build-host paths; -buildid= zeros the non-deterministic
# Go build id; -s -w drops debug info; -X stamps version/commit. CGO off so
# the binary is fully static and the rootfs needs no libc bridge.
# SOURCE_DATE_EPOCH is forwarded so any tooling that honors it stays pinned.
RUN SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH}" go build \
        -trimpath \
        -ldflags "-s -w -buildid= -X main.version=${VERSION} -X main.commit=${COMMIT}" \
        -o /out/wsl-vpnfix \
        ./cmd/wsl-vpnfix

# ---- Stage 2: gvproxy builder ----
# Reuses the builder toolchain (one pinned apk go). The clone is checked
# against the pinned commit before the patch is applied, so a tag-only
# Renovate bump or a moved tag fails here. Upstream vendors its modules,
# so nothing else is fetched.
FROM builder AS gvproxy-builder

ARG GVTV_TAG=v0.9.0
ARG GVTV_COMMIT

COPY build/patches/gvproxy-hires-clock.patch /patches/

WORKDIR /gvtv
RUN set -eu; \
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "${GVTV_TAG}" https://github.com/containers/gvisor-tap-vsock.git .; \
    head=$(git rev-parse HEAD); \
    if [ "${head}" != "${GVTV_COMMIT}" ]; then \
        echo "gvisor-tap-vsock ${GVTV_TAG} is ${head}, pinned ${GVTV_COMMIT}" >&2; exit 1; \
    fi; \
    git apply --check /patches/gvproxy-hires-clock.patch; \
    git apply /patches/gvproxy-hires-clock.patch; \
    GOFLAGS="-buildvcs=false -mod=vendor" go test ./pkg/virtualnetwork -run TestQPC; \
    GOFLAGS="-buildvcs=false -mod=vendor" GOOS=windows GOARCH=amd64 go build \
        -trimpath \
        -ldflags "-s -w -buildid= -H=windowsgui -X github.com/containers/gvisor-tap-vsock/pkg/types.gitVersion=${GVTV_TAG}-wsl-vpnfix" \
        -o /out/gvproxy-windowsgui.exe \
        ./cmd/gvproxy; \
    chmod 0644 /out/gvproxy-windowsgui.exe

# ---- Stage 3: Upstream fetcher ----
FROM alpine@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS fetcher

ARG GVTV_TAG=v0.9.0
ARG GVTV_GVFORWARDER_SHA256

RUN apk add --no-cache curl ca-certificates

WORKDIR /upstream

# Fail loud on a mismatch: the checksum comes from build/upstream-pins.yaml
# via build/pack.sh build args.
RUN set -eu; \
    base="https://github.com/containers/gvisor-tap-vsock/releases/download/${GVTV_TAG}"; \
    curl -fsSL "${base}/gvforwarder" -o gvforwarder; \
    echo "${GVTV_GVFORWARDER_SHA256}  gvforwarder" | sha256sum -c -; \
    chmod 0755 gvforwarder

# ---- Stage 4: Final rootfs ----
FROM alpine@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS final

RUN apk add --no-cache \
        nftables \
        iproute2 \
        ca-certificates \
        tzdata \
    && rm -rf /var/cache/apk/* /var/log/* /tmp/* \
    && rm -f /usr/bin/wget \
    && mkdir -p /etc/ld.so.conf.d

# Ship the SHA-256 manifest of bundled binaries inside the rootfs so the
# orchestrator (or a curious operator) can verify what shipped without
# fetching anything external.
COPY --from=builder  /out/wsl-vpnfix                        /sbin/wsl-vpnfix
COPY --from=fetcher  /upstream/gvforwarder                  /sbin/wsl-gvforwarder
COPY --from=gvproxy-builder /out/gvproxy-windowsgui.exe   /etc/wsl-vpnfix/wsl-gvproxy.exe
COPY                 LICENSE                                /LICENSE

# /sbin/init -> /sbin/wsl-vpnfix : the rootfs has no systemd; we are PID 1.
RUN ln -sf /sbin/wsl-vpnfix /sbin/init

# Embed the pinned binaries' sha256s for in-distro verification.
RUN sha256sum /sbin/wsl-vpnfix /sbin/wsl-gvforwarder /etc/wsl-vpnfix/wsl-gvproxy.exe \
        > /etc/wsl-vpnfix/checksums

# wsl.conf: appliance distro, root login, no Windows PATH bleeding into us,
# tightened automount. Interop must stay enabled so gvforwarder can launch
# wsl-gvproxy.exe via WSL_INTEROP.
#
# [boot] command=/sbin/wsl-vpnfix runs the orchestrator at distro boot as a
# child of WSL's own /init, NOT as PID 1. We tried [boot] systemd=true on
# 2026-05-09 and it broke interop on Windows 11 + WSL kernel 6.6.87.2: WSL
# expects systemd-style integration (sd_notify, systemctl, user sessions)
# and when those fail, the interop layer drops into half-broken state where
# gvproxy.exe runs but its stdio bridge to gvforwarder is one-way. Upstream
# sakai135/wsl-vpnkit uses [boot] command= for the same reason.
#
# Side effect: the PID-1 reaper code in cmd/wsl-vpnfix/init.go (B2) does not
# fire because Getpid() != 1. The code stays in the repo as defensive cover
# in case we ever rehome to a PID-1 architecture; it adds ~50 lines and zero
# runtime cost.
RUN printf '%s\n' \
        '[boot]' \
        'command = /sbin/wsl-vpnfix' \
        '' \
        '[interop]' \
        'enabled = true' \
        'appendWindowsPath = false' \
        '' \
        '[user]' \
        'default = root' \
        '' \
        '[automount]' \
        'enabled = true' \
        'options = "metadata,umask=22,fmask=11"' \
        > /etc/wsl.conf

# File modes — explicit so a host umask cannot leak into our image.
# wsl-gvproxy.exe MUST be 0755: WSL interop binfmt-dispatches Windows .exe
# files based on the executable bit, not just file extension. Without +x,
# fork/exec fails with EACCES and gvforwarder's stdio dial loops forever.
RUN chmod 0755 /sbin/wsl-vpnfix /sbin/wsl-gvforwarder /etc/wsl-vpnfix/wsl-gvproxy.exe \
    && chmod 0644 /etc/wsl-vpnfix/checksums /etc/wsl.conf /LICENSE \
    && chown -R 0:0 /sbin/wsl-vpnfix /sbin/wsl-gvforwarder /etc/wsl-vpnfix /etc/wsl.conf /LICENSE
